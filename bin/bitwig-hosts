#!/bin/bash
# bitwig-hosts — add/remove Bitwig phone-home blocks in /etc/hosts
# Run via sudo. Prevents Bitwig Settings UI freeze caused by
# synchronous network calls on the GUI thread.
set -euo pipefail

MARKER="# bitwig-phone-home-block"
HOSTS="/etc/hosts"

ENTRIES=(
    "0.0.0.0 services.bitwig.com"
    "0.0.0.0 dash.bitwig.com"
)

case "${1:-}" in
    on)
        # Idempotent — skip if already present
        grep -qF "$MARKER" "$HOSTS" && exit 0
        printf '\n%s\n' "$MARKER" >> "$HOSTS"
        for entry in "${ENTRIES[@]}"; do
            printf '%s %s\n' "$entry" "$MARKER" >> "$HOSTS"
        done
        ;;
    off)
        # Remove all lines tagged with our marker
        if grep -qF "$MARKER" "$HOSTS"; then
            sed -i "/$MARKER/d" "$HOSTS"
        fi
        ;;
    *)
        echo "Usage: bitwig-hosts on|off" >&2
        exit 1
        ;;
esac
