#!/bin/bash
# Test harness for music-mode's pause_units / resume_units, and the
# notification inhibit with its tray bell.
#
# Sources the real script with its command dispatch cut off, and runs single
# functions against a fake systemctl, systemd-run and busctl and a private cache
# dir. It touches no real unit or tray, kills nothing and loads no firewall.
#
# Usage: tests/test-pause-units [-v]     (exit 0 = all passed)

# Fake command bodies and the sourced snippet are single-quoted on purpose:
# they read $MOCK and their arguments when they run, not when written.
# shellcheck disable=SC2016

set -u

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT="$DIR/../bin/music-mode"
VERBOSE="${1:-}"
PASS=0
FAIL=0

setup() {
    MOCK=$(mktemp -d)
    mkdir -p "$MOCK/bin" "$MOCK/active" "$MOCK/cache"
    export MOCK

    # Everything above the dispatch: functions and constants only.
    sed '/^case "\${1:-status}" in/,$d' "$SCRIPT" > "$MOCK/lib.sh"

    # Fake systemctl: a unit is active while $MOCK/active/<unit> exists.
    cat > "$MOCK/bin/systemctl" <<'FAKE'
#!/bin/bash
echo "$*" >> "$MOCK/systemctl.log"
verb=""; unit=""
for a in "$@"; do
    case "$a" in
        is-active|stop|start) verb="$a" ;;
        -*) ;;
        *) unit="$a" ;;
    esac
done
case "$verb" in
    is-active) [ -e "$MOCK/active/$unit" ] ;;
    stop)
        [ -e "$MOCK/stop_fails" ] && exit 1
        rm -f "$MOCK/active/$unit"
        # a stop job that fails after the unit is already down
        [ -e "$MOCK/stop_errors_but_stops" ] && exit 1
        exit 0 ;;
    start) [ -e "$MOCK/start_fails" ] && exit 1; : > "$MOCK/active/$unit" ;;
esac
FAKE
    # A failed restart raises a desktop notification: never the real one.
    printf '#!/bin/sh\necho "$*" >> "$MOCK/notify.log"\n' > "$MOCK/bin/notify-send"
    # kde_dnd_on starts its unit with systemd-run: log it, fail on request.
    printf '#!/bin/sh\necho "$*" >> "$MOCK/systemd-run.log"\n[ ! -e "$MOCK/run_fails" ]\n' > "$MOCK/bin/systemd-run"
    # Fake busctl: plasmashell's tray. The bell is hidden while
    # $MOCK/bell_hidden exists; $MOCK/no_plasma makes the call fail.
    cat > "$MOCK/bin/busctl" <<'FAKE'
#!/bin/bash
echo "${*:1:6}" >> "$MOCK/busctl.log"
[ -e "$MOCK/no_plasma" ] && exit 1
case "${*: -1}" in
    "var op = 'hide'"*) [ -e "$MOCK/bell_hidden" ] && { echo 's ""'; exit 0; }
                        : > "$MOCK/bell_hidden" ;;
    "var op = 'show'"*) [ -e "$MOCK/bell_hidden" ] || { echo 's ""'; exit 0; }
                        rm -f "$MOCK/bell_hidden" ;;
esac
echo 's "changed\n"'
FAKE
    chmod +x "$MOCK/bin"/*
    : > "$MOCK/systemctl.log"; : > "$MOCK/notify.log"; : > "$MOCK/systemd-run.log"
    : > "$MOCK/busctl.log"
    RECORD="$MOCK/cache/music-mode/paused-units"
    MARK="$MOCK/cache/music-mode/tray-bell-hidden"
}
teardown() { rm -rf "$MOCK"; }

check() {
    if [ "$2" = "$3" ]; then
        PASS=$((PASS + 1)); [ "$VERBOSE" = "-v" ] && printf '    ok   %s (%s)\n' "$1" "$3"
    else
        FAIL=$((FAIL + 1)); printf '    FAIL %s: expected [%s], got [%s]\n' "$1" "$2" "$3"
    fi
    return 0
}
run() { printf '  %s\n' "$1"; }
# call <cache dir> <function>: run it in a fresh shell, print its exit status
call() {
    XDG_CACHE_HOME="$1" PATH="$MOCK/bin:$PATH" bash -c \
        'source "$1"; "$2"' _ "$MOCK/lib.sh" "$2" > "$MOCK/out.txt" 2>&1
    echo $?
}
# call_only <function>: the same, with nothing on PATH but the fakes
call_only() {
    XDG_CACHE_HOME="$MOCK/cache" PATH="$MOCK/bin" "$BASH" -c \
        'source "$1"; "$2"' _ "$MOCK/lib.sh" "$1" > "$MOCK/out.txt" 2>&1
    echo $?
}
running() { : > "$MOCK/active/$1"; }
active()  { [ -e "$MOCK/active/$1" ] && echo yes || echo no; }
recorded() { [ -s "$RECORD" ] && echo yes || echo no; }
bell()    { [ -e "$MOCK/bell_hidden" ] && echo hidden || echo shown; }
marked()  { [ -e "$MARK" ] && echo yes || echo no; }
calls()   { grep -c -- " $1 " "$MOCK/systemctl.log"; }

run "the cut-down script still holds the functions under test"
setup
check "pause_units"  "1" "$(grep -c '^pause_units()' "$MOCK/lib.sh")"
check "resume_units" "1" "$(grep -c '^resume_units()' "$MOCK/lib.sh")"
# shellcheck disable=SC2016  # a literal line of the script, not an expansion
check "no dispatch"  "0" "$(grep -c '^case "\${1:-status}" in' "$MOCK/lib.sh")"
teardown

run "a running unit is stopped and recorded"
setup
running syncthing.service
check "exit 0"   "0"                 "$(call "$MOCK/cache" pause_units)"
check "stopped"  "no"                "$(active syncthing.service)"
check "recorded" "syncthing.service" "$(cat "$RECORD" 2>/dev/null)"
check "says so"  "1"                 "$(grep -c 'paused syncthing.service' "$MOCK/out.txt")"
teardown

run "a unit that is not running is left alone"
setup
check "exit 0"       "0"  "$(call "$MOCK/cache" pause_units)"
check "no stop call" "0"  "$(calls stop)"
check "not recorded" "no" "$(recorded)"
teardown

run "a unit that will not stop is a warning, not a failed engage"
setup
running syncthing.service; : > "$MOCK/stop_fails"
check "exit 0"        "0"   "$(call "$MOCK/cache" pause_units)"
check "warns"         "1"   "$(grep -c 'could not pause syncthing.service' "$MOCK/out.txt")"
check "still running" "yes" "$(active syncthing.service)"
check "not recorded"  "no"  "$(recorded)"
teardown

run "a stop that reports an error but leaves the unit down keeps it on the record"
setup
running syncthing.service; : > "$MOCK/stop_errors_but_stops"
check "exit 0"   "0"                 "$(call "$MOCK/cache" pause_units)"
check "down"     "no"                "$(active syncthing.service)"
check "recorded" "syncthing.service" "$(cat "$RECORD" 2>/dev/null)"
check "says off will start it" "1"   "$(grep -c 'off will start it again' "$MOCK/out.txt")"
teardown

run "an unwritable cache dir pauses nothing"
setup
running syncthing.service; : > "$MOCK/not-a-dir"
check "exit 0"        "0"   "$(call "$MOCK/not-a-dir" pause_units)"
check "warns"         "1"   "$(grep -c 'background services not paused' "$MOCK/out.txt")"
check "still running" "yes" "$(active syncthing.service)"
teardown

run "a unit that cannot be recorded is not stopped"
setup
running syncthing.service; mkdir -p "$RECORD"
check "exit 0"        "0"   "$(call "$MOCK/cache" pause_units)"
check "warns"         "1"   "$(grep -c 'leaving it running' "$MOCK/out.txt")"
check "still running" "yes" "$(active syncthing.service)"
teardown

run "resume starts what was recorded and removes the record"
setup
mkdir -p "$MOCK/cache/music-mode"; echo syncthing.service > "$RECORD"
check "exit 0"       "0"   "$(call "$MOCK/cache" resume_units)"
check "started"      "yes" "$(active syncthing.service)"
check "record gone"  "no"  "$([ -e "$RECORD" ] && echo yes || echo no)"
teardown

run "resume with no record starts nothing"
setup
check "exit 0"            "0" "$(call "$MOCK/cache" resume_units)"
check "systemctl not run" "0" "$(grep -c . "$MOCK/systemctl.log")"
teardown

run "a unit recorded twice is started once"
setup
mkdir -p "$MOCK/cache/music-mode"; printf 'syncthing.service\n\nsyncthing.service\n' > "$RECORD"
check "exit 0"    "0" "$(call "$MOCK/cache" resume_units)"
check "one start" "1" "$(calls start)"
teardown

run "a unit that will not start is named, notified, and kept for the next off"
setup
mkdir -p "$MOCK/cache/music-mode"; echo syncthing.service > "$RECORD"; : > "$MOCK/start_fails"
check "exit 0"            "0"                 "$(call "$MOCK/cache" resume_units)"
check "names the unit"    "1"                 "$(grep -c 'systemctl --user start syncthing.service' "$MOCK/out.txt")"
check "desktop notice"    "1"                 "$(grep -c 'could not restart syncthing.service' "$MOCK/notify.log")"
check "still on record"   "syncthing.service" "$(cat "$RECORD" 2>/dev/null)"
rm "$MOCK/start_fails"
check "next off: exit 0"  "0"                 "$(call "$MOCK/cache" resume_units)"
check "next off: started" "yes"               "$(active syncthing.service)"
check "next off: record gone" "no"            "$([ -e "$RECORD" ] && echo yes || echo no)"
teardown

run "the inhibit reports whether anything is held, and never aborts"
setup
check "started: returns 0"       "0" "$(call "$MOCK/cache" kde_dnd_on)"
check "asks for both"            "1" "$(grep -c -- 'kde-inhibit --notifications --power sleep infinity' "$MOCK/systemd-run.log")"
: > "$MOCK/run_fails"
check "unit fails: returns 1"    "1" "$(call "$MOCK/cache" kde_dnd_on)"
check "unit fails: warns"        "1" "$(grep -c 'inhibit failed' "$MOCK/out.txt")"
check "no kde-inhibit: returns 1" "1" "$(call_only kde_dnd_on)"
check "no kde-inhibit: warns"    "1" "$(grep -c 'kde-inhibit not found' "$MOCK/out.txt")"
teardown

run "the tray bell is hidden while the inhibit is held, and shown again by off"
setup
check "on: returns 0"   "0"      "$(call "$MOCK/cache" kde_dnd_on)"
check "on: hidden"      "hidden" "$(bell)"
check "on: marked"      "yes"    "$(marked)"
call "$MOCK/cache" kde_dnd_on > /dev/null
check "on again: one edit" "1"  "$(grep -c . "$MOCK/busctl.log")"
check "off: returns 0"  "0"      "$(call "$MOCK/cache" kde_dnd_off)"
check "off: shown"      "shown"  "$(bell)"
check "off: mark gone"  "no"     "$(marked)"
teardown

run "a bell you hid yourself stays hidden after off"
setup
: > "$MOCK/bell_hidden"
call "$MOCK/cache" kde_dnd_on > /dev/null
check "on: not marked"  "no"     "$(marked)"
call "$MOCK/cache" kde_dnd_off > /dev/null
check "off: hidden"     "hidden" "$(bell)"
teardown

run "a failed inhibit leaves the bell alone"
setup
: > "$MOCK/run_fails"
call "$MOCK/cache" kde_dnd_on > /dev/null
check "shown"           "shown"  "$(bell)"
check "tray untouched"  "0"      "$(grep -c . "$MOCK/busctl.log")"
teardown

run "no plasmashell: the inhibit still holds, and off retries the bell"
setup
: > "$MOCK/no_plasma"
check "on: returns 0"   "0"      "$(call "$MOCK/cache" kde_dnd_on)"
check "on: not marked"  "no"     "$(marked)"
rm "$MOCK/no_plasma"
call "$MOCK/cache" kde_dnd_on > /dev/null
: > "$MOCK/no_plasma"
check "off: returns 0"  "0"      "$(call "$MOCK/cache" kde_dnd_off)"
check "off: kept mark"  "yes"    "$(marked)"
rm "$MOCK/no_plasma"
call "$MOCK/cache" kde_dnd_off > /dev/null
check "next off: shown" "shown"  "$(bell)"
check "next off: mark gone" "no" "$(marked)"
teardown

run "an unwritable cache dir leaves the bell alone"
setup
: > "$MOCK/not-a-dir"
check "returns 0"       "0"      "$(call "$MOCK/not-a-dir" kde_dnd_on)"
check "shown"           "shown"  "$(bell)"
teardown

run "pause then resume leaves the unit running and no record"
setup
running syncthing.service
call "$MOCK/cache" pause_units > /dev/null
check "exit 0"      "0"   "$(call "$MOCK/cache" resume_units)"
check "running"     "yes" "$(active syncthing.service)"
check "record gone" "no"  "$([ -e "$RECORD" ] && echo yes || echo no)"
teardown

echo ""
if [ "$FAIL" -eq 0 ]; then printf '%s passed, 0 failed\n' "$PASS"; exit 0; fi
printf '%s passed, %s FAILED\n' "$PASS" "$FAIL"; exit 1
